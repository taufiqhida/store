generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  name        String
  email       String?
  role        String    @default("ADMIN")
  permissions String    @default("[]")
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("admin_users")
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique(map: "Article_slug_key")
  content     String   @db.Text
  image       String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("article")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique(map: "Category_slug_key")
  isActive Boolean   @default(true)
  products Product[]

  @@map("category")
}

model Discount {
  id          Int       @id @default(autoincrement())
  code        String    @unique(map: "Discount_code_key")
  name        String
  type        String    @default("fixed")
  value       Float
  maxDiscount Float?
  minPurchase Float?
  applyTo     String    @default("all")
  productIds  String?   @db.Text
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  usageCount  Int       @default(0)
  usageLimit  Int?

  @@map("discount")
}

model FlashSale {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?  @db.Text
  productId       Int
  discountPercent Float
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  variantId       Int?

  @@map("flashsale")
}

model Order {
  id                 Int      @id @default(autoincrement())
  productName        String
  variantName        String
  quantity           Int
  price              Float
  uniqueCode         Int
  totalPrice         Float
  paymentMethod      String
  status             String   @default("pending")
  whatsappSent       Boolean  @default(false)
  createdAt          DateTime @default(now())
  orderCode          String   @unique(map: "Order_orderCode_key")
  buyerMessage       String?  @db.Text
  discountAmount     Float    @default(0)
  discountCode       String?
  paymentAccountInfo String?  @db.Text
  paymentFee         Float    @default(0)
  phone              String?

  @@map("order")
}

model PaymentMethod {
  id          Int     @id @default(autoincrement())
  name        String
  icon        String?
  isActive    Boolean @default(true)
  accountInfo String? @db.Text
  currency    String  @default("IDR")
  feeType     String  @default("fixed")
  fees        Float   @default(0)
  iconType    String  @default("emoji")
  qrisImage   String?

  @@map("paymentmethod")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique(map: "Product_slug_key")
  description String    @db.Text
  image       String
  badge       String?
  categoryId  Int
  createdAt   DateTime  @default(now())
  isActive    Boolean   @default(true)
  category    Category  @relation(fields: [categoryId], references: [id], map: "Product_categoryId_fkey")
  variants    Variant[]

  @@index([categoryId], map: "Product_categoryId_fkey")
  @@map("product")
}

model StoreSettings {
  id    Int    @id @default(autoincrement())
  key   String @unique(map: "StoreSettings_key_key")
  value String @db.Text

  @@map("storesettings")
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  orderCode   String
  name        String
  content     String   @db.Text
  rating      Int      @default(5)
  productName String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("testimonial")
}

model Variant {
  id            Int     @id @default(autoincrement())
  name          String
  price         Float
  originalPrice Float
  isWarranty    Boolean @default(false)
  productId     Int
  isActive      Boolean @default(true)
  capitalPrice  Float   @default(0)
  product       Product @relation(fields: [productId], references: [id], map: "Variant_productId_fkey")

  @@index([productId], map: "Variant_productId_fkey")
  @@map("variant")
}
